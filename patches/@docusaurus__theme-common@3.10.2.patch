-const segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
+/*
+ * Fences a crash on pre-iOS 17 devices.
+ *
+ * The `v` (unicodeSets) flag reached Safari in 17, and \p{RGI_Emoji} is a
+ * property of strings, so it cannot be rewritten under `u`. The bundler
+ * downlevels the literal to a RegExp constructor call, which turns what
+ * would be a parse error into a runtime throw - "Invalid flags supplied to
+ * RegExp constructor" - blanking every page that renders a DocCard.
+ *
+ * Intl.Segmenter has the same shape of problem, from iOS 14.1.
+ *
+ * Both fall back to treating the label as having no leading emoji, which is
+ * what every label on this site does anyway.
+ */
+const segmenter = typeof Intl !== "undefined" && typeof Intl.Segmenter === "function"
+    ? new Intl.Segmenter(undefined, { granularity: "grapheme" })
+    : null;
+let rgiEmoji;
+try {
+    rgiEmoji = new RegExp("^\\p{RGI_Emoji}$", "v");
+}
+catch {
+    // Single code points plus flag pairs: loses keycaps such as 1<VS16><keycap>.
+    rgiEmoji = /^(?:\p{Extended_Pictographic}|\p{Regional_Indicator}{2})/u;
+}
 /**
